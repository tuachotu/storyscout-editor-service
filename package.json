{
  "name": "storyscout-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StoryScout transcript refinement service",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/client-sqs": "^3.910.0",
    "@storyscout/llm-client": "file:../LLMCient",
    "fastify": "^5.6.1",
    "pino": "^9.12.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
